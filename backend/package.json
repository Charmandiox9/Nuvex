{
  "name": "@nuvex/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:infra": "docker compose -f compose.yaml -f compose.dev.yaml up -d --wait db redis storage",
    "dev:infra:stop": "docker compose -f compose.yaml -f compose.dev.yaml stop db redis storage",
    "start:dev": "pnpm generate && tsc-watch --noClear --noEmitOnError --onSuccess \"node dist/src/main.js\"",
    "start:worker:dev": "node --watch dist/src/worker/main.js",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "build:server": "pnpm generate && tsc",
    "start:api": "node dist/src/main.js",
    "start:worker": "node dist/src/worker/main.js",
    "owner": "node dist/src/owner.js",
    "openapi": "node dist/src/openapi.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apollo/server": "^5",
    "@as-integrations/express5": "^1",
    "@aws-sdk/client-s3": "^3",
    "@nestjs/apollo": "^13",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/graphql": "^13",
    "@nestjs/platform-express": "^11",
    "@nestjs/swagger": "^11",
    "@node-rs/argon2": "^2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "archiver": "^7.0.1",
    "bullmq": "^5",
    "class-transformer": "^0.5",
    "class-validator": "^0.15",
    "cookie-parser": "^1",
    "dotenv": "^17",
    "graphql": "^16",
    "graphql-tag": "^2",
    "ipaddr.js": "^2",
    "otpauth": "^9",
    "qrcode": "^1",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "sharp": "^0.34"
  },
  "devDependencies": {
    "@playwright/test": "^1",
    "@types/archiver": "^6.0.4",
    "@types/cookie-parser": "^1",
    "@types/express": "^5",
    "@types/jest": "^30",
    "@types/node": "^24",
    "@types/qrcode": "^1",
    "@types/supertest": "^6",
    "jest": "^30",
    "prisma": "7.10.1",
    "supertest": "^7",
    "tsc-watch": "7.2.1",
    "typescript": "~5.9"
  }
}
